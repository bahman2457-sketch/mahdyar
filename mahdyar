    <div class="note" id="note"></div>
    <div class="banner" id="offline" hidden>آفلاین هستید — داده‌های ذخیره‌شده نمایش داده می‌شوند</div>
    <button class="install" id="install" hidden>:calling: نصب روی دستگاه</button>
  </div>
  <div id="out"></div>
  <p class="foot">مهدیار — نسخهٔ ۱.۰ · ساخته‌شده با :heart:︎<br>منبع قیمت و سهام: TMC · منبع صورت‌های مالی: کدال. این صفحه توصیهٔ خرید یا فروش نیست.</p>
</div>

<script>
const API_BASE = '';

const SAMPLE = {
  symbol:'نوری', name:'پتروشیمی نوری', updated:'۱۴۰۵/۰۶/۳۱',
  marketCap:'حدود ۲۸۰ هزار میلیارد تومان', pe:6.8, eps:2576,
  kpi:[
    {t:'رشد فروش آخرین ماه نسبت به سال قبل',v:12,up:1,s:'+'},
    {t:'رشد فروش آخرین ماه نسبت به ماه قبل',v:8,up:1,s:'+'},
    {t:'رشد سود خالص',v:266,up:1,s:'+'},
    {t:'رشد درآمد عملیاتی',v:154,up:1,s:'+'},
    {t:'حاشیه سود ناخالص',v:33.7},
    {t:'حاشیه سود خالص',v:18.1},
    {t:'نسبت جاری',v:1.02,raw:1},
    {t:'بازده حقوق صاحبان سهام (ROE)',v:18.5}
  ],
  trend:{labels:['۱۴۰۱','۱۴۰۲','۱۴۰۳','۱۴۰۴','۱۴۰۵ (۶ماهه)'],revenue:[800,900,1080,1170,1350],profit:[470,550,630,780,950]},
  mix:[{n:'بنزین',v:25,c:'#2f6fe4'},{n:'رافینیت',v:35,c:'#f59e0b'},{n:'پارازایلین',v:15,c:'#22a35a'},{n:'سایر محصولات',v:25,c:'#7c5cd6'}],
  pl:[['درآمد عملیاتی',1366586060],['سود ناخالص',460302960],['سود عملیاتی',310093138],['سود خالص',247267825]],
  health:[{n:'نسبت جاری',v:1.02,pct:51,c:'#2f6fe4',raw:1},{n:'بدهی به دارایی',v:62,pct:62,c:'#22a35a'},{n:'حاشیه سود عملیاتی',v:22.7,pct:22.7,c:'#f59e0b'},{n:'بازده دارایی‌ها (ROA)',v:13.6,pct:13.6,c:'#7c5cd6'}],
  summary:'پتروشیمی نوری با برخورداری از مزیت‌های رقابتی، موقعیت مناسب در زنجیرهٔ ارزش و رشد پایدار فروش، در میان شرکت‌های برتر صنعت پتروشیمی قرار دارد.'
};

async function getData(sym) {
  if (!API_BASE) return { d: SAMPLE, live: false, reason: 'demo' };
  try {
    const r = await fetch(API_BASE + '/fundamental/' + encodeURIComponent(sym), { cache: 'no-store' });
    if (r.ok) {
      const data = await r.json();
      return { d: data, live: data._sources && data._sources.tmc, reason: null };
    }
    if (r.status === 404) return { d: SAMPLE, live: false, reason: 'not-found' };
    if (r.status >= 500) return { d: SAMPLE, live: false, reason: 'offline' };
    return { d: SAMPLE, live: false, reason: 'error' };
  } catch (e) {
    return { d: SAMPLE, live: false, reason: 'offline' };
  }
}

const esc  = s => String(s).replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fa   = (n, p) => Number(n).toLocaleString('fa-IR', { maximumFractionDigits: p == null ? 2 : p });
const dash = (v, f) => v == null ? '—' : f(v);

function barChart(t){
  const max = 1500, base = 160, h = 130, x0 = 44, gw = 54;
  let g = '';
  [0,500,1000,1500].forEach(v => {
    const y = base - v/max*h;
    g += <line x1="${x0-4}" x2="316" y1="${y}" y2="${y}" stroke="var(--line)"/><text x="${x0-8}" y="${y+4}" font-size="10" text-anchor="end" fill="var(--mut)">${fa(v,0)}</text>;
});
  t.labels.forEach((l,i) => {
    const x = x0 + i*gw + 8;
    const r = t.revenue[i]/max*h, p = t.profit[i]/max*h;
    g += <rect x="${x}" y="${base-r}" width="17" height="${r}" rx="2" fill="#2a56b8"/><rect x="${x+19}" y="${base-p}" width="17" height="${p}" rx="2" fill="#f59e0b"/><text x="${x+18}" y="178" font-size="9" text-anchor="middle" fill="var(--mut)">${esc(l)}</text>;
  });
  return <div class="scroll"><svg viewBox="0 0 320 186" width="100%" style="direction:ltr;min-width:300px" role="img" aria-label="روند درآمد و سود خالص">${g}</svg></div>
  <div class="legend"><span><i style="background:#2a56b8"></i>درآمد عملیاتی</span><span><i style="background:#f59e0b"></i>سود خالص</span></div>;
}

function donut(mix){
  const r = 40, C = 2*Math.PI*r; let acc = 0, s = '';
  mix.forEach(m => {
    const len = m.v/100*C;
    s += <circle cx="60" cy="60" r="${r}" fill="none" stroke="${m.c}" stroke-width="18" stroke-dasharray="${len} ${C-len}" stroke-dashoffset="${-acc}" transform="rotate(-90 60 60)"/>;
    acc += len;
  });
  const lg = mix.map(m => <span><i style="background:${m.c}"></i>${esc(m.n)} (${fa(m.v,0)}٪)</span>).join('');
  return <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
    <svg viewBox="0 0 120 120" width="150" height="150" role="img" aria-label="ترکیب فروش محصولات">${s}<text x="60" y="57" text-anchor="middle" font-size="9" font-weight="700" fill="var(--ink)">مهم‌ترین</text><text x="60" y="69" text-anchor="middle" font-size="9" font-weight="700" fill="var(--ink)">محصولات</text></svg>
    <div class="legend" style="flex-direction:column;gap:6px">${lg}</div></div>;
}

function render(d, live, sym, reason){
  const note = document.getElementById('note');
  if (live) {
    note.textContent = 'داده زنده از TMC + کدال';
  } else if (reason === 'offline') {
    note.textContent = 'اتصال برقرار نیست؛ دادهٔ نمونه نمایش داده می‌شود.';
  } else if (reason === 'not-found') {
    note.textContent = نماد «${sym}» پیدا نشد؛ نمونهٔ «${d.symbol}» نمایش داده می‌شود.;
  } else if (reason === 'error') {
    note.textContent = 'خطا در دریافت داده؛ نمونه نمایش داده می‌شود.';
  } else {
    note.textContent = 'نمایش داده نمونه · اتصال به سرور داده برقرار نیست.';
  }

  const kpis = (d.kpi || []).map(k => {
    const val = k.raw ? fa(k.v) : (k.s || '') + fa(k.v, 1) + '٪';
    return <div class="kpi"><small>${esc(k.t)}</small><b class="${k.up ? 'up' : ''}">${k.up ? '▲ ' : ''}${val}</b></div>;
  }).join('');
  const pl = (d.pl || []).map(r => <tr><td>${esc(r[0])}</td><td>${fa(r[1],0)}</td></tr>).join('');
  const hl = (d.health || []).map(h => <div class="bar"><div class="row"><span>${esc(h.n)}</span><b>${h.raw ? fa(h.v) : fa(h.v,1) + '٪'}</b></div><div class="track"><div class="fill" style="width:${h.pct}%;background:${h.c}"></div></div></div>).join('');

  document.getElementById('out').innerHTML = 
  <div class="card"><div class="chip">${esc(d.name)} · ${esc(d.symbol)}</div>
    <div class="grid g2">
      <div class="stat"><small>آخرین بروزرسانی</small><b>${dash(d.updated, esc)}</b></div>
      <div class="stat"><small>ارزش بازار</small><b style="font-size:14px">${dash(d.marketCap, esc)}</b></div>
      <div class="stat"><small>P/E</small><b>${dash(d.pe, v => fa(v,1))}</b></div>
      <div class="stat"><small>EPS (ریال)</small><b>${dash(d.eps, v => fa(v,0))}</b></div>
    </div></div>
  ${kpis ? <div class="card"><div class="chip">شاخص‌های کلیدی عملکرد</div><div class="grid g2">${kpis}</div></div> : ''}
  ${d.trend ? <div class="card"><div class="chip">روند عملکرد شرکت</div>${barChart(d.trend)}</div> : ''}
  ${d.mix ? <div class="card"><div class="chip">ترکیب فروش محصولات</div>${donut(d.mix)}</div> : ''}
  ${pl ? <div class="card"><div class="chip">صورت سود و زیان (خلاصه)</div><div style="font-size:12px;color:var(--mut)">مبلغ (میلیون ریال)</div><table>${pl}</table></div>` : ''}
${hl ? <div class="card"><div class="chip">وضعیت مالی و نقدینگی</div>${hl}</div> : ''}
  ${d.codal && (d.codal.financial?.length || d.codal.monthly?.length) ? 
    <div class="card">
      <div class="chip">آخرین گزارش‌های کدال</div>
      ${d.codal.ok === false && d.codal.error ? <div style="font-size:12px;color:var(--warn);margin-bottom:8px">:warning: ${esc(d.codal.error)}</div> : ''}
      ${d.codal.financial?.length ? 
        <div style="font-size:13px;color:var(--mut);margin:8px 0 4px">صورت‌های مالی</div>
        <table>${d.codal.financial.slice(0, 5).map(r => 
          <tr>
            <td>${esc(r.title)}<br><small style="color:var(--mut)">${esc(r.published)}</small></td>
            <td>${r.url ? <a href="${esc(r.url)}" target="_blank" style="color:var(--brand2);text-decoration:none">مشاهده :arrow_upper_right:</a> : '—'}</td>
          </tr>).join('')}</table> : ''}
      ${d.codal.monthly?.length ? 
        <div style="font-size:13px;color:var(--mut);margin:14px 0 4px">گزارش فعالیت ماهانه</div>
        <table>${d.codal.monthly.slice(0, 5).map(r => 
          <tr>
            <td>${esc(r.title)}<br><small style="color:var(--mut)">${esc(r.published)}</small></td>
            <td>${r.url ? <a href="${esc(r.url)}" target="_blank" style="color:var(--brand2);text-decoration:none">مشاهده :arrow_upper_right:</a> : '—'}</td>
          </tr>).join('')}</table> : ''}
      ${d.codal.fromCache ? '<div style="font-size:11px;color:var(--mut);margin-top:8px">📦 از کش محلی</div>' : ''}
    </div> : ''}
  ${d.summary ? <div class="card sum"><h3>✓ جمع‌بندی</h3><p>${esc(d.summary)}</p></div> : ''}`;
}

async function run(){
  const sym = document.getElementById('q').value.trim();
  if (!sym) return;
  document.getElementById('out').innerHTML =
    '<div class="card" style="text-align:center;color:var(--mut);padding:30px">در حال دریافت…</div>';
  const { d, live, reason } = await getData(sym);
  render(d, live, sym, reason);
}

let deferredPrompt = null;
const installBtn = document.getElementById('install');

window.addEventListener('beforeinstallprompt', (e) => {
  e.preventDefault();
  deferredPrompt = e;
  if (installBtn) installBtn.hidden = false;
});

if (installBtn) {
  installBtn.addEventListener('click', async () => {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      await deferredPrompt.userChoice;
      deferredPrompt = null;
      installBtn.hidden = true;
      return;
    }
    alert('در Chrome: منوی ⋮ → Install app\nدر Safari: Share → Add to Home Screen');
  });
}

window.addEventListener('appinstalled', () => {
  deferredPrompt = null;
  if (installBtn) installBtn.hidden = true;
});

(function iosHint(){
  const isIOS = /iPhone|iPad|iPod/i.test(navigator.userAgent);
  const standalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
  if (isIOS && !standalone && installBtn) {
    installBtn.hidden = false;
    installBtn.textContent = ':calling: راهنمای نصب (Safari)';
    installBtn.addEventListener('click', () => {
      alert('در Safari: دکمهٔ Share (مربع با فلش رو به بالا) → Add to Home Screen.');
    }, { once: true });
  }
})();

const offlineEl = document.getElementById('offline');
function updateOnline() { if (offlineEl) offlineEl.hidden = navigator.onLine; }
window.addEventListener('online', updateOnline);
window.addEventListener('offline', updateOnline);
updateOnline();

if ('serviceWorker' in navigator) {
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('/sw.js').catch(() => {});
  });
}

const initSym = new URLSearchParams(location.search).get('symbol');
if (initSym) document.getElementById('q').value = initSym;
document.getElementById('go').addEventListener('click', run);
document.getElementById('q').addEventListener('keydown', e => { if (e.key === 'Enter') run(); });
run();
</script>
</body>
</html>
